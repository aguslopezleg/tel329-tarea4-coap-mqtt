# El programa lee variables de entorno. Con Node >=22: node --env-file=.env middleware.cjs
SENSOR_URL=http://[fd00::202:2:2:2]/
DEVICE_ID=contiki-ng-01
INTERVAL_MS=3000
# Azure: cadena del DISPOSITIVO. Nunca incluirla en el ZIP ni en Git.
IOTHUB_DEVICE_CONNECTION_STRING=
# Suscriptor: cadena Event Hubs-compatible del endpoint integrado, con EntityPath.
EVENTHUB_CONNECTION_STRING=
CONSUMER_GROUP=$Default
# Alternativa LOCAL: no definir IOTHUB_DEVICE_CONNECTION_STRING al utilizarla.
# LOCAL_OUTPUT=local-cloud.jsonl
# LIMIT=10
